# ===============================================================
# Marswalk Planner — Environment Configuration Template
# ===============================================================
# Copy this file to .env or backend/.env and customize as needed.
# Do not commit files containing actual secrets or private credentials.

# Application Environment (development | production | testing)
MARSWALK_ENVIRONMENT=development

# Debug Mode (true | false)
MARSWALK_DEBUG=false

# Backend API Prefix
MARSWALK_API_PREFIX=/api/v1

# Data Lake Root Directory (relative or absolute path)
MARSWALK_DATA_DIR=data

# Allowed CORS Origins (comma-separated or JSON list)
MARSWALK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
